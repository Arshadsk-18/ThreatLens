# ThreatLens v3 Backend Configuration Template
# Single Source of Truth: docs/ARCHITECTURE_API_CONTRACT.md, Sections 17, 21

# Database Configuration:
# - Local development / test: sqlite:///./threatlens.db
# - Deployed production (Supabase Postgres): Use pooled connection string (port 6543) with sslmode=require
#   Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./threatlens.db

# Frontend CORS Origins (JSON array or comma-separated list of exact origins, NO WILDCARDS in production)
# Development default: ["http://localhost:5173"]
# Production example: ["https://threatlens.vercel.app"]
CORS_ORIGINS=["http://localhost:5173"]

# Provider & Pipeline Runtime Settings
APPLE_COUNTRY=in
CACHE_TTL_SECONDS=3600
SCAN_TIMEOUT_SECONDS=90

# Optional P1 Capability Settings (leave blank if P1 is not enabled)
LLM_API_KEY=
LLM_MODEL=
BLUESKY_APP_PASSWORD=
BLUESKY_HANDLE=

# -----------------------------------------------------------------------------
# Frontend Environment Notice (Vercel):
# - Set VITE_API_URL to the deployed backend URL (e.g., https://threatlens-api.onrender.com).
# - NEVER include backend secrets, service role keys, or passwords in VITE_* variables.
# -----------------------------------------------------------------------------
